---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title}>
  <div class="article-layout">
    <!-- 正文区域 -->
    <article class="article">
      <header class="article-header">
        <span class="article-category">{post.data.categories || '未分类'}</span>
        <h1 class="article-title">{post.data.title}</h1>
        <time class="article-date">{post.data.date.toISOString().split('T')[0]}</time>
      </header>
      <div class="article-body" id="article-body">
        <Content />
      </div>

      <!-- 文章底部信息 -->
      <footer class="article-footer">
        <div class="article-footer-tags">
          {post.data.tags?.length && post.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        <a href="/" class="back-home">&larr; 返回首页</a>
      </footer>
    </article>

    <!-- 目录侧边栏 -->
    <aside class="toc-sidebar">
      <div class="toc-sticky">
        <h4 class="toc-title">目录</h4>
        <nav id="toc-nav" class="toc-nav">
          <p class="toc-empty">加载中…</p>
        </nav>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  // 构建目录并添加锚点
  function buildTOC() {
    const articleBody = document.getElementById('article-body');
    if (!articleBody) return;

    const headings = articleBody.querySelectorAll('h2, h3');
    if (headings.length === 0) {
      const tocNav = document.getElementById('toc-nav');
      if (tocNav) tocNav.innerHTML = '<p class="toc-empty">暂无目录</p>';
      return;
    }

    const tocNav = document.getElementById('toc-nav');
    if (!tocNav) return;

    tocNav.innerHTML = '';

    headings.forEach((heading, index) => {
      // 生成稳定的 id
      const id = `heading-${index}`;
      heading.id = id;

      // 创建 TOC 条目
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = heading.textContent || '';
      a.className = heading.tagName === 'H2' ? 'toc-h2' : 'toc-h3';
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById(id);
        if (target) {
          const offset = 80;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });
          // 更新 URL hash
          history.pushState(null, '', `#${id}`);
        }
      });

      tocNav.appendChild(a);
    });
  }

  // 高亮当前目录项
  function setupScrollSpy() {
    const headings = document.querySelectorAll('#article-body h2[id], #article-body h3[id]');
    const tocLinks = document.querySelectorAll('#toc-nav a');
    if (headings.length === 0 || tocLinks.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          const link = document.querySelector(`#toc-nav a[href="#${id}"]`);
          if (link) {
            if (entry.isIntersecting) {
              tocLinks.forEach((l) => l.classList.remove('toc-active'));
              link.classList.add('toc-active');
            }
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
  }

  document.addEventListener('DOMContentLoaded', () => {
    buildTOC();
    setupScrollSpy();
  });
</script>

<style>
  /* ========== Article Layout — 正文 + 目录 ========== */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 48px;
    padding: 48px 0 60px;
    align-items: start;
  }

  /* ========== 正文 ========== */
  .article {
    min-width: 0;
  }

  .article-header {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .article-category {
    display: inline-block;
    align-self: flex-start;
    font-size: 11px;
    background: var(--primary-bg);
    color: var(--primary);
    padding: 3px 12px;
    border-radius: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .article-date {
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* 正文排版 */
  .article-body {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
  }

  .article-body :global(h2) {
    font-size: 22px;
    font-weight: 600;
    margin: 44px 0 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
    scroll-margin-top: 80px;
  }

  .article-body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin: 32px 0 10px;
    scroll-margin-top: 80px;
  }

  .article-body :global(p) {
    margin-bottom: 14px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 14px;
    padding-left: 22px;
  }

  .article-body :global(li) {
    margin-bottom: 6px;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding: 10px 18px;
    margin: 18px 0;
    background: #f8fafc;
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-secondary);
    font-size: 14px;
  }

  .article-body :global(img) {
    max-width: 100%;
    border-radius: var(--radius);
    margin: 18px 0;
  }

  .article-body :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* 脚部 */
  .article-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .article-footer-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .tag {
    font-size: 12px;
    background: var(--primary-bg);
    color: var(--primary);
    padding: 4px 10px;
    border-radius: 8px;
  }

  .back-home {
    font-size: 13px;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .back-home:hover {
    color: var(--primary);
  }

  /* ========== TOC 侧边栏 ========== */
  .toc-sidebar {
    display: block;
  }

  .toc-sticky {
    position: sticky;
    top: calc(var(--header-height) + 24px);
  }

  .toc-title {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 10px;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: calc(100vh - 160px);
    overflow-y: auto;
  }

  .toc-nav a {
    display: block;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-secondary);
    padding: 4px 0;
    border-left: 2px solid transparent;
    padding-left: 12px;
    transition: all 0.15s;
  }

  .toc-nav a:hover {
    color: var(--primary);
  }

  .toc-nav a.toc-active {
    color: var(--primary);
    border-left-color: var(--primary);
    font-weight: 500;
  }

  .toc-nav a.toc-h3 {
    padding-left: 24px;
    font-size: 11px;
  }

  .toc-empty {
    font-size: 12px;
    color: var(--text-secondary);
  }

  /* ========== Responsive ========== */
  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .toc-sidebar {
      display: none;
    }

    .article-title {
      font-size: 24px;
    }
  }
</style>
