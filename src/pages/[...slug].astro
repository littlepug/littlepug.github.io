---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CoverImage from '../components/CoverImage.astro';
import { getCategoryLabel } from '../utils/categories';
import { resolveCover } from '../utils/covers';
import { getReadingMinutes } from '../utils/reading-time';
export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const readingMin = getReadingMinutes(post.body ?? '');
const categoryLabel = getCategoryLabel(post.data.categories);
const description = post.data.excerpt || post.data.title;
const coverSrc = resolveCover(post.data.cover, post.data.categories);
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={coverSrc}
  ogType="article"
>
  <div class="article-layout">
    <article class="article">
      <Breadcrumb
        items={[
          { label: '首页', href: '/' },
          { label: '归档', href: '/archive' },
          { label: post.data.title },
        ]}
      />

      {
        coverSrc ? (
          <CoverImage src={coverSrc} alt={post.data.title} />
        ) : null
      }

      <header class="article-header">
        <span class="article-category">{categoryLabel}</span>
        <h1 class="article-title">{post.data.title}</h1>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString().split('T')[0]}>
            {post.data.date.toISOString().split('T')[0]}
          </time>
          <span class="article-dot" aria-hidden="true">&middot;</span>
          <span>{readingMin} min 阅读</span>
        </div>
      </header>

      <div class="article-body" id="article-body">
        <Content />
      </div>

      <footer class="article-footer">
        {
          post.data.tags?.length ? (
            <div class="article-footer-tags">
              {post.data.tags.map((tag: string) => (
                <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">
                  {tag}
                </a>
              ))}
            </div>
          ) : null
        }
        <a href="/" class="back-home">&larr; 返回首页</a>
      </footer>
    </article>

    <aside class="toc-sidebar" id="toc-sidebar" aria-label="文章目录">
      <div class="toc-inner">
        <h4 class="toc-title">目录</h4>
        <nav id="toc-nav" class="toc-nav">
          <p class="toc-empty">加载中…</p>
        </nav>
      </div>
    </aside>

    <button id="back-to-top" class="back-to-top" type="button" aria-label="回到顶部">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="19" x2="12" y2="5" /><polyline points="5 12 12 5 19 12" />
      </svg>
    </button>
  </div>
</BaseLayout>

<script>
  function buildTOC() {
    const articleBody = document.getElementById('article-body');
    if (!articleBody) return;

    const headings = articleBody.querySelectorAll('h2, h3');
    const tocNav = document.getElementById('toc-nav');
    if (!tocNav) return;

    if (headings.length === 0) {
      tocNav.innerHTML = '<p class="toc-empty">暂无目录</p>';
      return;
    }

    tocNav.innerHTML = '';

    headings.forEach((heading, index) => {
      const id = `heading-${index}`;
      heading.id = id;

      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = heading.textContent || '';
      a.className = heading.tagName === 'H2' ? 'toc-h2' : 'toc-h3';
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById(id);
        if (target) {
          const top = target.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top, behavior: 'smooth' });
          history.pushState(null, '', `#${id}`);
        }
      });
      tocNav.appendChild(a);
    });
  }

  function setupScrollSpy() {
    const headings = document.querySelectorAll('#article-body h2[id], #article-body h3[id]');
    const tocLinks = document.querySelectorAll('#toc-nav a');
    if (headings.length === 0 || tocLinks.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          const link = document.querySelector(`#toc-nav a[href="#${id}"]`);
          if (link) {
            tocLinks.forEach((l) => l.classList.remove('toc-active'));
            link.classList.add('toc-active');
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
  }

  document.addEventListener('DOMContentLoaded', () => {
    buildTOC();
    setupScrollSpy();

    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            btn.classList.toggle('visible', window.scrollY > 400);
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    gap: 48px;
    padding: 40px 0 60px;
    align-items: start;
  }

  .article {
    min-width: 0;
  }

  .article-header {
    margin-bottom: 36px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .article-category {
    display: inline-block;
    align-self: flex-start;
    font-size: 11px;
    background: var(--primary-bg);
    color: var(--primary);
    padding: 3px 12px;
    border-radius: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .article-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .article-dot {
    color: var(--border);
  }

  .article-body {
    font-size: 15px;
    line-height: 1.85;
  }

  .article-body :global(h2) {
    font-size: 22px;
    font-weight: 600;
    margin: 44px 0 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
    scroll-margin-top: 88px;
  }

  .article-body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin: 32px 0 10px;
    scroll-margin-top: 88px;
  }

  .article-body :global(p) {
    margin-bottom: 14px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 14px;
    padding-left: 22px;
  }

  .article-body :global(li) {
    margin-bottom: 6px;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding: 10px 18px;
    margin: 18px 0;
    background: var(--blockquote-bg);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-secondary);
    font-size: 14px;
  }

  .article-body :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin: 20px 0;
    border: 1px solid var(--border);
    background: var(--card-bg);
    box-sizing: border-box;
  }

  .article-body :global(p:has(img)) {
    margin: 0;
  }

  .article-body :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .article-footer-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .tag {
    font-size: 12px;
    background: var(--primary-bg);
    color: var(--primary);
    padding: 4px 10px;
    border-radius: 8px;
    transition: opacity 0.2s;
  }

  .tag:hover {
    opacity: 0.85;
  }

  .back-home {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .back-home:hover {
    color: var(--primary);
  }

  .toc-sidebar {
    display: none;
  }

  @media (min-width: 960px) {
    .toc-sidebar {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + 24px);
      max-height: calc(100vh - var(--header-height) - 48px);
      overflow-y: auto;
    }
  }

  .toc-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-nav a {
    display: block;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-secondary);
    padding: 4px 0 4px 12px;
    border-left: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .toc-nav a:hover,
  .toc-nav a.toc-active {
    color: var(--primary);
    border-left-color: var(--primary);
    font-weight: 500;
  }

  .toc-nav a.toc-h3 {
    padding-left: 22px;
    font-size: 11px;
  }

  .toc-empty {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .back-to-top {
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(91, 91, 214, 0.35);
    z-index: 99;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.3s, transform 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (max-width: 959px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .article-title {
      font-size: 24px;
    }
  }
</style>
