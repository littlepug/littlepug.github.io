---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, sortPostsByDateDesc } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('posts'));
  const tagSet = new Set<string>();
  for (const post of posts) {
    post.data.tags?.forEach((t) => tagSet.add(t));
  }
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const filtered = sortPostsByDateDesc(
  getPublishedPosts(await getCollection('posts')).filter((p) =>
    p.data.tags?.includes(tag)
  )
);
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的 ${filtered.length} 篇文章`}>
  <section class="tag-posts">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: '标签', href: '/tags' },
        { label: tag },
      ]}
    />

    <header class="tag-header">
      <h1>#{tag}</h1>
      <p>{filtered.length} 篇文章</p>
    </header>

    <div class="posts-grid">
      {
        filtered.map((post) => {
          const slug = post.id.replace(/\.md$/, '');
          return (
            <PostCard
              slug={slug}
              title={post.data.title}
              date={post.data.date}
              excerpt={post.data.excerpt}
              categories={post.data.categories}
              cover={post.data.cover}
              body={post.body ?? ''}
            />
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .tag-posts {
    padding: 32px 0 60px;
  }

  .tag-header h1 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .tag-header p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
  }

  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
