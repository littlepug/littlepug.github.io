---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="归档">
  <section class="archive">
    <header class="archive-header">
      <h1>归档</h1>
      <p>共 {sortedPosts.length} 篇文章</p>
    </header>
    <div class="archive-list">
      {sortedPosts.map((post) => {
        const slug = post.id.replace(/\.md$/, '');
        return (
          <a href={`/${slug}`} class="archive-item">
            <time class="archive-date">{post.data.date.toISOString().split('T')[0]}</time>
            <span class="archive-post-title">{post.data.title}</span>
            <span class="archive-category">{post.data.categories || '未分类'}</span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 0 60px;
  }

  .archive-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .archive-header h1 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .archive-header p {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .archive-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .archive-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 15px 20px;
    border-radius: 10px;
    transition: background 0.2s;
  }

  .archive-item:hover {
    background: var(--card-bg);
  }

  .archive-date {
    font-size: 13px;
    color: var(--text-secondary);
    font-family: 'Fira Code', monospace;
    white-space: nowrap;
    min-width: 90px;
  }

  .archive-post-title {
    font-size: 15px;
    font-weight: 500;
    flex: 1;
  }

  .archive-item:hover .archive-post-title {
    color: var(--primary);
  }

  .archive-category {
    font-size: 11px;
    color: var(--primary);
    background: var(--primary-bg);
    padding: 2px 10px;
    border-radius: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .archive { padding: 32px 0; }
    .archive-item {
      flex-wrap: wrap;
      gap: 6px;
      padding: 12px 16px;
    }
    .archive-date { min-width: auto; }
  }
</style>
