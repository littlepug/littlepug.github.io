---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="归档">
  <section class="archive">
    <h1 class="archive-title">归档</h1>
    <div class="archive-list">
      {sortedPosts.map((post) => (
        <a href={`/${post.id.replace(/\.md$/, '')}`} class="archive-item">
          <time class="archive-date">{post.data.date.toISOString().split('T')[0]}</time>
          <span class="archive-post-title">{post.data.title}</span>
          {post.data.categories && (
            <span class="archive-category">{post.data.categories}</span>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    max-width: 700px;
    margin: 0 auto;
    padding: 60px 0;
  }

  .archive-title {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 40px;
    text-align: center;
  }

  .archive-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .archive-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-radius: 10px;
    transition: background 0.2s;
  }

  .archive-item:hover {
    background: var(--card-bg);
  }

  .archive-date {
    font-size: 13px;
    color: var(--text-secondary);
    font-family: 'Fira Code', monospace;
    white-space: nowrap;
    min-width: 90px;
  }

  .archive-post-title {
    font-size: 15px;
    font-weight: 500;
    flex: 1;
  }

  .archive-category {
    font-size: 11px;
    color: var(--primary);
    background: #eef2ff;
    padding: 2px 10px;
    border-radius: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .archive { padding: 40px 0; }
    .archive-item { flex-wrap: wrap; gap: 8px; padding: 12px 16px; }
    .archive-date { min-width: auto; }
  }
</style>
