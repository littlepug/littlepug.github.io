---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getCategoryLabel } from '../utils/categories';
import { getReadingMinutes } from '../utils/reading-time';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const postsByYear: Record<number, typeof sortedPosts> = {};
for (const post of sortedPosts) {
  const year = post.data.date.getFullYear();
  if (!postsByYear[year]) postsByYear[year] = [];
  postsByYear[year].push(post);
}
const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="归档" description={`共 ${sortedPosts.length} 篇技术文章归档`}>
  <section class="archive">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '归档' }]} />

    <div class="archive-header">
      <h1>全部内容</h1>
      <p>共 {sortedPosts.length} 篇文章</p>
    </div>

    <div class="archive-years">
      {
        years.map((year) => (
          <div class="year-group">
            <h2 class="year-heading">{year}</h2>
            <div class="year-posts">
              {
                postsByYear[year].map((post) => {
                  const slug = post.id.replace(/\.md$/, '');
                  const readingMin = getReadingMinutes(post.body ?? '');
                  return (
                    <a href={`/${slug}`} class="archive-item">
                      <time class="archive-date" datetime={post.data.date.toISOString().split('T')[0]}>
                        {post.data.date.toISOString().split('T')[0]}
                      </time>
                      <span class="archive-post-title">{post.data.title}</span>
                      <span class="archive-category">{getCategoryLabel(post.data.categories)}</span>
                      <span class="archive-reading-time">{readingMin} min</span>
                    </a>
                  );
                })
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 0 60px;
  }

  .archive-header {
    margin-bottom: 36px;
  }

  .archive-header h1 {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .archive-header p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 6px;
  }

  .archive-years {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .year-heading {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
  }

  .archive-item {
    display: grid;
    grid-template-columns: 92px 1fr auto auto;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border-radius: 8px;
    transition: background 0.15s;
  }

  .archive-item:hover {
    background: var(--card-bg);
  }

  .archive-date {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: 'Fira Code', monospace;
  }

  .archive-post-title {
    font-size: 15px;
    font-weight: 500;
  }

  .archive-item:hover .archive-post-title {
    color: var(--primary);
  }

  .archive-category {
    font-size: 11px;
    color: var(--primary);
    background: var(--primary-bg);
    padding: 2px 8px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .archive-reading-time {
    font-size: 11px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .archive-item {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
    }

    .archive-date {
      grid-column: 1;
    }

    .archive-reading-time {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .archive-post-title {
      grid-column: 1 / -1;
    }

    .archive-category {
      grid-column: 1;
    }
  }
</style>
