---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../site.config';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const postCount = sortedPosts.length;
const tagSet = new Set<string>();
for (const post of sortedPosts) {
  post.data.tags?.forEach((t) => tagSet.add(t));
}
const tagCount = tagSet.size;
const latestYear = sortedPosts[0]?.data.date.getFullYear() ?? new Date().getFullYear();
const writingYears = latestYear - site.sinceYear + 1;

let githubRepos: string | null = null;
try {
  const res = await fetch(`https://api.github.com/users/${site.githubUser}`, {
    headers: { Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = await res.json();
    githubRepos = String(data.public_repos ?? '');
  }
} catch {
  /* 构建环境无网络时使用占位 */
}
---

<BaseLayout>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <img
        src={site.avatar}
        alt={site.author}
        class="hero-avatar"
        width="88"
        height="88"
        loading="eager"
      />
      <p class="hero-eyebrow">Building useful notes.</p>
      <h1>{site.author}</h1>
      <p class="hero-tagline">
        Java 后端开发，记录 Spring、Elasticsearch、Kafka 与分布式相关的实践笔记。
      </p>
      <ul class="hero-bullets">
        <li>专注后端工程与大数据组件的搭建、运维与原理梳理</li>
        <li>自 {site.sinceYear} 年起持续写作，欢迎通过 GitHub 交流</li>
      </ul>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">{postCount}</span>
          <span class="stat-label">篇文章</span>
        </div>
        <div class="stat">
          <span class="stat-number">{tagCount}</span>
          <span class="stat-label">个标签</span>
        </div>
        <div class="stat">
          <span class="stat-number">{writingYears}</span>
          <span class="stat-label">年写作</span>
        </div>
        <div class="stat">
          <span class="stat-number">{githubRepos ?? '—'}</span>
          <span class="stat-label">GitHub 仓库</span>
        </div>
      </div>
      <div class="hero-cta">
        <a href="/archive" class="btn btn-primary">浏览归档</a>
        <a href={site.github} class="btn btn-ghost" target="_blank" rel="noopener">GitHub</a>
        <a href="/about" class="btn btn-ghost">关于我</a>
      </div>
    </div>
  </section>

  <section class="section-header">
    <h2>最近文章</h2>
    <a href="/archive" class="view-all">查看全部 &rarr;</a>
  </section>

  <section class="posts-grid">
    {
      sortedPosts.map((post) => {
        const slug = post.id.replace(/\.md$/, '');
        return (
          <PostCard
            slug={slug}
            title={post.data.title}
            date={post.data.date}
            excerpt={post.data.excerpt}
            categories={post.data.categories}
            cover={post.data.cover}
            body={post.body ?? ''}
          />
        );
      })
    }
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: 64px 0 52px;
    margin: 0 -24px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(91, 91, 214, 0.1), transparent),
      radial-gradient(ellipse 60% 50% at 80% 60%, rgba(139, 139, 245, 0.07), transparent),
      radial-gradient(ellipse 50% 40% at 20% 40%, rgba(91, 91, 214, 0.05), transparent);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 560px;
    margin: 0 auto;
  }

  .hero-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--card-bg);
    box-shadow: 0 4px 24px rgba(91, 91, 214, 0.22);
    transition: transform 0.3s ease;
  }

  .hero-avatar:hover {
    transform: scale(1.04);
  }

  .hero-eyebrow {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .hero h1 {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .hero-tagline {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .hero-bullets {
    list-style: none;
    text-align: left;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    padding: 0;
    margin: 4px 0 0;
    width: 100%;
  }

  .hero-bullets li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 6px;
  }

  .hero-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
  }

  .hero-stats {
    display: flex;
    gap: 32px;
    margin-top: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .stat-number {
    font-size: 26px;
    font-weight: 700;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 11px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 8px;
  }

  .btn {
    font-size: 14px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: 999px;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--primary);
    color: #fff;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .btn-ghost {
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-secondary);
  }

  .btn-ghost:hover {
    color: var(--primary);
    border-color: var(--primary);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 48px 0 24px;
  }

  .section-header h2 {
    font-size: 20px;
    font-weight: 600;
  }

  .view-all {
    font-size: 13px;
    color: var(--primary);
    font-weight: 500;
  }

  .view-all:hover {
    opacity: 0.75;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
    padding-bottom: 60px;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 44px 0 36px;
      margin: 0;
    }

    .hero h1 {
      font-size: 26px;
    }

    .hero-stats {
      gap: 20px;
    }

    .stat-number {
      font-size: 22px;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
