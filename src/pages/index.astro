---
import BaseLayout from '../layouts/BaseLayout.astro';

// 文章列表（手动维护，后续可改为 content collections）
const posts = [
  {
    slug: '2021-01-29-elasticsearch-rolling-restart',
    title: 'Elasticsearch 滚动重启',
    date: '2021-01-29',
    category: 'elasticsearch',
    cover: 'https://images.unsplash.com/photo-1504639725590-34d0984388bd?w=600&q=80',
    excerpt: '详细介绍 Elasticsearch 集群的滚动重启策略与操作步骤，确保零停机维护。',
  },
  {
    slug: '2020-09-11-kafka-zookeeper',
    title: 'Kafka 与 Zookeeper 集群搭建',
    date: '2020-09-11',
    category: 'kafka',
    cover: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&q=80',
    excerpt: '从零搭建 Kafka 集群与 Zookeeper 集群的完整指南，包含配置文件详解。',
  },
  {
    slug: '2020-09-10-elasticsearch-kibana',
    title: 'Elasticsearch 集群搭建与 Kibana 安装',
    date: '2020-09-10',
    category: 'elasticsearch',
    cover: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=600&q=80',
    excerpt: '手把手教你搭建 Elasticsearch 集群并安装 Kibana 可视化工具。',
  },
  {
    slug: '2020-07-30-spring-ioc',
    title: 'Spring IoC 详解',
    date: '2020-07-30',
    category: 'java',
    cover: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&q=80',
    excerpt: '深入理解 Spring IoC 容器原理、依赖注入机制及源码分析。',
  },
  {
    slug: '2020-07-30-spring-aop',
    title: 'Spring AOP 详解',
    date: '2020-07-30',
    category: 'java',
    cover: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=600&q=80',
    excerpt: '全面解析 Spring AOP 的代理机制、切面编程实践与底层原理。',
  },
];
---

<BaseLayout title="首页">
  <!-- Hero 区 - 模仿 nexmoe.com -->
  <section class="hero">
    <div class="hero-content">
      <img src="/images/avatar.jpg" alt="littlepug" class="hero-avatar" />
      <h1>littlepug</h1>
      <p class="hero-tagline">Java 后端开发 · 专注 Spring / 大数据 / 分布式</p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">{posts.length}</span>
          <span class="stat-label">篇文章</span>
        </div>
        <div class="stat">
          <span class="stat-number">Java</span>
          <span class="stat-label">主力语言</span>
        </div>
        <div class="stat">
          <span class="stat-number">Spring</span>
          <span class="stat-label">核心框架</span>
        </div>
        <div class="stat">
          <span class="stat-number">2020</span>
          <span class="stat-label">开始写作</span>
        </div>
      </div>
      <div class="hero-social">
        <a href="https://github.com/littlepug" target="_blank" rel="noopener" title="GitHub">
          <i class="fab fa-github"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 文章卡片网格 -->
  <section class="posts-grid">
    {posts.map((post) => (
      <a href={`/${post.slug}`} class="post-card">
        <div class="post-card-image">
          <img src={post.cover} alt={post.title} loading="lazy" />
          <span class="post-card-category">{post.category}</span>
        </div>
        <div class="post-card-body">
          <time class="post-card-date">{post.date}</time>
          <h2 class="post-card-title">{post.title}</h2>
          <p class="post-card-excerpt">{post.excerpt}</p>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    text-align: center;
    padding: 80px 0 60px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .hero-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border);
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.15);
  }

  .hero h1 {
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero-tagline {
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 480px;
  }

  .hero-stats {
    display: flex;
    gap: 40px;
    margin-top: 16px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-number {
    font-size: 28px;
    font-weight: 700;
    color: var(--primary);
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-social {
    margin-top: 12px;
    display: flex;
    gap: 12px;
  }

  .hero-social a {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--card-bg);
    border: 1px solid var(--border);
    font-size: 18px;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .hero-social a:hover {
    color: var(--primary);
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    padding-bottom: 60px;
  }

  .post-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: transparent;
  }

  .post-card-image {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post-card:hover .post-card-image img {
    transform: scale(1.05);
  }

  .post-card-category {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(4px);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
  }

  .post-card-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .post-card-date {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .post-card-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
  }

  .post-card-excerpt {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  @media (max-width: 768px) {
    .hero { padding: 48px 0 40px; }
    .hero h1 { font-size: 28px; }
    .hero-stats { gap: 24px; }
    .stat-number { font-size: 22px; }
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
