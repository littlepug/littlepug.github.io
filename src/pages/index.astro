---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="首页">
  <!-- Hero — 带渐变背景 -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <img src="/images/avatar.jpg" alt="littlepug" class="hero-avatar" />
      <h1>littlepug</h1>
      <p class="hero-tagline">Java 后端开发 · 专注 Spring / 大数据 / 分布式</p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">{sortedPosts.length}</span>
          <span class="stat-label">篇文章</span>
        </div>
        <div class="stat">
          <span class="stat-number">Java</span>
          <span class="stat-label">主力语言</span>
        </div>
        <div class="stat">
          <span class="stat-number">Spring</span>
          <span class="stat-label">核心框架</span>
        </div>
        <div class="stat">
          <span class="stat-number">2020</span>
          <span class="stat-label">开始写作</span>
        </div>
      </div>
      <div class="hero-social">
        <a href="https://github.com/littlepug" target="_blank" rel="noopener" aria-label="GitHub">
          <i class="fab fa-github"></i>
        </a>
        <a href="/archive" aria-label="归档">
          <i class="fas fa-archive"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 文章列表 -->
  <section class="section-header">
    <h2>最近文章</h2>
    <a href="/archive" class="view-all">查看全部 &rarr;</a>
  </section>

  <section class="posts-grid">
    {sortedPosts.map((post) => {
      const slug = post.id.replace(/\.md$/, '');
      return (
        <a href={`/${slug}`} class="post-card">
          <div class="post-card-image">
            <div class="post-card-placeholder">
              <i class="fas fa-file-alt"></i>
            </div>
            <span class="post-card-category">{post.data.categories || '未分类'}</span>
          </div>
          <div class="post-card-body">
            <time class="post-card-date">{post.data.date.toISOString().split('T')[0]}</time>
            <h2 class="post-card-title">{post.data.title}</h2>
            <p class="post-card-excerpt">{post.data.excerpt || '暂无摘要'}</p>
          </div>
        </a>
      );
    })}
  </section>
</BaseLayout>

<style>
  /* ========== Hero ========== */
  .hero {
    position: relative;
    text-align: center;
    padding: 72px 0 56px;
    margin: 0 -24px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(99, 102, 241, 0.08), transparent),
      radial-gradient(ellipse 60% 50% at 80% 60%, rgba(129, 140, 248, 0.06), transparent),
      radial-gradient(ellipse 50% 40% at 20% 40%, rgba(99, 102, 241, 0.04), transparent);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .hero-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
    box-shadow: 0 4px 24px rgba(99, 102, 241, 0.2);
    transition: transform 0.3s ease;
  }

  .hero-avatar:hover {
    transform: scale(1.05);
  }

  .hero h1 {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .hero-tagline {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 420px;
  }

  .hero-stats {
    display: flex;
    gap: 36px;
    margin-top: 8px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .stat-number {
    font-size: 26px;
    font-weight: 700;
    color: var(--primary);
  }

  .stat-label {
    font-size: 11px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero-social {
    margin-top: 8px;
    display: flex;
    gap: 10px;
  }

  .hero-social a {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--card-bg);
    border: 1px solid var(--border);
    font-size: 15px;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .hero-social a:hover {
    color: var(--primary);
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  /* ========== Section Header ========== */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 48px 0 24px;
  }

  .section-header h2 {
    font-size: 20px;
    font-weight: 600;
  }

  .view-all {
    font-size: 13px;
    color: var(--primary);
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .view-all:hover {
    opacity: 0.7;
  }

  /* ========== Posts Grid ========== */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 22px;
    padding-bottom: 60px;
  }

  .post-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
    border-color: transparent;
  }

  .post-card-image {
    position: relative;
    width: 100%;
    height: 180px;
    overflow: hidden;
  }

  .post-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--primary-bg), #f0f4ff);
    font-size: 36px;
    color: var(--primary-light);
    transition: transform 0.4s ease;
  }

  .post-card:nth-child(2n) .post-card-placeholder {
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    color: #d97706;
  }

  .post-card:nth-child(3n) .post-card-placeholder {
    background: linear-gradient(135deg, #d1fae5, #a7f3d0);
    color: #059669;
  }

  .post-card:nth-child(5n) .post-card-placeholder {
    background: linear-gradient(135deg, #fce7f3, #f9a8d4);
    color: #db2777;
  }

  .post-card:hover .post-card-placeholder {
    transform: scale(1.06);
  }

  .post-card-category {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
  }

  .post-card-body {
    padding: 18px 20px 22px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .post-card-date {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .post-card-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-excerpt {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .hero { padding: 48px 0 40px; margin: 0; }
    .hero h1 { font-size: 26px; }
    .hero-stats { gap: 24px; flex-wrap: wrap; justify-content: center; }
    .stat-number { font-size: 22px; }
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
