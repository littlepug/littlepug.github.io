---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="面包屑">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span class="breadcrumb-sep">/</span>}
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span class="breadcrumb-current">{item.label}</span>
        )}
      </>
    ))
  }
</nav>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb-sep {
    color: var(--border);
  }

  .breadcrumb-current {
    color: var(--text);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(320px, 70vw);
  }
</style>
