---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<img
  class="article-cover-banner"
  src={src}
  alt={alt}
  width="800"
  height="450"
  loading="eager"
  decoding="async"
/>

<style>
  .article-cover-banner {
    display: block;
    width: 100%;
    max-height: 280px;
    height: auto;
    object-fit: contain;
    object-position: center;
    margin-bottom: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg);
  }
</style>
