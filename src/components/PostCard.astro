---
import { getCategoryLabel, getCardAccentIndex } from '../utils/categories';
import { resolveCover } from '../utils/covers';
import { getReadingMinutes } from '../utils/reading-time';

interface Props {
  slug: string;
  title: string;
  date: Date;
  excerpt?: string;
  categories?: string;
  cover?: string;
  body: string;
}

const { slug, title, date, excerpt, categories, cover, body } = Astro.props;
const readingMin = getReadingMinutes(body);
const categoryLabel = getCategoryLabel(categories);
const accent = getCardAccentIndex(slug);
const coverSrc = resolveCover(cover, categories);
const dateStr = date.toISOString().split('T')[0];
---

<a href={`/${slug}`} class="post-card">
  <div class="post-card-image">
    {
      coverSrc ? (
        <img
          class="post-card-cover"
          src={coverSrc}
          alt={title}
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class:list={['post-card-placeholder', `accent-${accent}`]}>
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
          </svg>
        </div>
      )
    }
    <span class="post-card-category">{categoryLabel}</span>
  </div>
  <div class="post-card-body">
    <time class="post-card-date" datetime={dateStr}>{dateStr}</time>
    <h2 class="post-card-title">{title}</h2>
    <p class="post-card-excerpt">{excerpt || '暂无摘要'}</p>
    <span class="post-card-reading-time">{readingMin} min 阅读</span>
  </div>
</a>

<style>
  .post-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
    border-color: transparent;
  }

  .post-card-image {
    position: relative;
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: var(--bg);
  }

  .post-card-cover {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: contain;
    object-position: center;
    background: var(--bg);
    transition: transform 0.4s ease;
  }

  .post-card:hover .post-card-cover {
    transform: scale(1.02);
  }

  .post-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s ease;
  }

  .post-card-placeholder.accent-0 {
    background: linear-gradient(135deg, var(--primary-bg), #e0e7ff);
    color: var(--primary);
  }

  .post-card-placeholder.accent-1 {
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    color: #b45309;
  }

  .post-card-placeholder.accent-2 {
    background: linear-gradient(135deg, #d1fae5, #a7f3d0);
    color: #047857;
  }

  .post-card-placeholder.accent-3 {
    background: linear-gradient(135deg, #fce7f3, #fbcfe8);
    color: #be185d;
  }

  .post-card:hover .post-card-placeholder {
    transform: scale(1.04);
  }

  .post-card-category {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--primary);
  }

  :global([data-theme='dark']) .post-card-category {
    background: rgba(30, 30, 47, 0.88);
    color: var(--primary-light);
  }

  .post-card-body {
    padding: 18px 20px 22px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .post-card-date {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .post-card-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-excerpt {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-reading-time {
    font-size: 11px;
    color: var(--text-secondary);
    margin-top: 4px;
  }
</style>
