---
import { getCollection } from 'astro:content';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
}

const { title, description, image, ogType = 'website' } = Astro.props;
const pageTitle = title ? `${title} - ${site.title}` : site.title;
const pageDesc = description ?? site.description;
const pageImage = new URL(image ?? site.ogImage, site.url).href;
const canonical = new URL(Astro.url.pathname, site.url).href;
const currentPath = Astro.url.pathname;

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const recentPosts = sortedPosts.slice(0, 5);

const navItems = [
  { href: '/', label: '首页' },
  { href: '/archive', label: '归档' },
  { href: '/tags', label: '标签' },
  { href: '/about', label: '关于' },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDesc} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={site.avatar} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={pageImage} />
  <meta property="og:locale" content="zh_CN" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={pageImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&family=Fira+Code:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
  <script is:inline>
    (function () {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <img src={site.avatar} alt="" class="brand-avatar" width="32" height="32" />
        <span class="brand-name">{site.author}</span>
      </a>

      <nav class="nav-main" aria-label="主导航">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={['nav-item', { active: currentPath === item.href }]}
            >
              {item.label}
            </a>
          ))
        }
        <a href={site.github} target="_blank" rel="noopener" class="nav-item nav-external">
          GitHub
        </a>
      </nav>

      <div class="header-actions">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="切换主题">
          <span class="icon-sun" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" />
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
              <line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" />
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
          </span>
          <span class="icon-moon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </span>
        </button>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="打开菜单" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>
    </div>

    <nav class="nav-mobile" id="nav-mobile" hidden>
      {
        navItems.map((item) => (
          <a href={item.href} class:list={['nav-item', { active: currentPath === item.href }]}>
            {item.label}
          </a>
        ))
      }
      <a href={site.github} target="_blank" rel="noopener" class="nav-item">GitHub</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div class="footer-col">
        <p class="footer-brand">
          &copy; {site.sinceYear} – {new Date().getFullYear()}
          <strong>{site.author}</strong>
        </p>
        <p class="footer-desc">{site.description}</p>
      </div>
      <div class="footer-col">
        <h3 class="footer-heading">导航</h3>
        <ul class="footer-list">
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3 class="footer-heading">最近文章</h3>
        <ul class="footer-list">
          {
            recentPosts.map((post) => {
              const slug = post.id.replace(/\.md$/, '');
              return (
                <li>
                  <a href={`/${slug}`}>{post.data.title}</a>
                </li>
              );
            })
          }
        </ul>
      </div>
      <div class="footer-col">
        <h3 class="footer-heading">社交</h3>
        <ul class="footer-list">
          <li>
            <a href={site.github} target="_blank" rel="noopener">GitHub</a>
          </li>
          <li>
            <a href="/about">联系与合作</a>
          </li>
        </ul>
      </div>
    </div>
    <p class="footer-built">Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
  </footer>

  <script>
    const root = document.documentElement;
    const themeBtn = document.getElementById('theme-toggle');
    const navBtn = document.getElementById('nav-toggle');
    const navMobile = document.getElementById('nav-mobile');

    themeBtn?.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });

    navBtn?.addEventListener('click', () => {
      const open = navMobile?.hasAttribute('hidden');
      if (open) {
        navMobile?.removeAttribute('hidden');
        navBtn.setAttribute('aria-expanded', 'true');
        navBtn.setAttribute('aria-label', '关闭菜单');
      } else {
        navMobile?.setAttribute('hidden', '');
        navBtn.setAttribute('aria-expanded', 'false');
        navBtn.setAttribute('aria-label', '打开菜单');
      }
    });

    navMobile?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navMobile.setAttribute('hidden', '');
        navBtn?.setAttribute('aria-expanded', 'false');
        navBtn?.setAttribute('aria-label', '打开菜单');
      });
    });
  </script>
</body>
</html>

<style is:global>
  :root,
  [data-theme='light'] {
    --bg: #f7f8fc;
    --card-bg: #ffffff;
    --text: #1e1e2f;
    --text-secondary: #6b7280;
    --primary: #5b5bd6;
    --primary-light: #8b8bf5;
    --primary-bg: #ededfc;
    --border: #e8ecf1;
    --shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    --shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.08);
    --header-bg: rgba(247, 248, 252, 0.85);
    --code-inline-bg: #f1f5f9;
    --blockquote-bg: #f8fafc;
  }

  [data-theme='dark'] {
    --bg: #12121a;
    --card-bg: #1c1c28;
    --text: #e8e8ef;
    --text-secondary: #9ca3af;
    --primary: #8b8bf5;
    --primary-light: #a5a5ff;
    --primary-bg: #2a2a42;
    --border: #2e2e40;
    --shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
    --shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.35);
    --header-bg: rgba(18, 18, 26, 0.88);
    --code-inline-bg: #2a2a3a;
    --blockquote-bg: #1a1a26;
  }

  :root {
    --radius: 14px;
    --max-width: 1100px;
    --header-height: 60px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
    transition: background 0.25s ease, color 0.25s ease;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--card-bg);
    box-shadow: 0 2px 8px rgba(91, 91, 214, 0.25);
  }

  .brand-name {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav-main {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-item {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 6px 0;
    transition: color 0.2s;
    position: relative;
  }

  .nav-item::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 100%;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
    transition: transform 0.25s ease;
  }

  .nav-item:hover,
  .nav-item.active {
    color: var(--text);
  }

  .nav-item:hover::after,
  .nav-item.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .theme-toggle,
  .nav-toggle {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .theme-toggle:hover,
  .nav-toggle:hover {
    color: var(--primary);
    border-color: var(--primary);
  }

  [data-theme='light'] .icon-moon,
  [data-theme='dark'] .icon-sun {
    display: none;
  }

  .nav-toggle {
    display: none;
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 20px 16px;
    border-top: 1px solid var(--border);
    background: var(--header-bg);
  }

  .nav-mobile:not([hidden]) {
    display: flex;
  }

  .nav-mobile .nav-item {
    padding: 10px 0;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    min-height: calc(100vh - var(--header-height) - 120px);
  }

  /* Footer */
  .site-footer {
    margin-top: 48px;
    padding: 40px 24px 28px;
    border-top: 1px solid var(--border);
    background: var(--card-bg);
  }

  .footer-grid {
    max-width: var(--max-width);
    margin: 0 auto 24px;
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 32px;
  }

  .footer-brand {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  .footer-brand strong {
    color: var(--text);
    font-weight: 600;
  }

  .footer-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 280px;
  }

  .footer-heading {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-list a {
    font-size: 13px;
    color: var(--text-secondary);
    transition: color 0.2s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .footer-list a:hover {
    color: var(--primary);
  }

  .footer-built {
    max-width: var(--max-width);
    margin: 0 auto;
    font-size: 12px;
    color: var(--text-secondary);
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .footer-built a {
    color: var(--primary);
  }

  code {
    font-family: 'Fira Code', monospace;
    font-size: 0.88em;
    background: var(--code-inline-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .article-body pre,
  pre.astro-code {
    border-radius: var(--radius);
    overflow-x: auto;
    margin: 20px 0;
    font-size: 14px;
    line-height: 1.6;
  }

  pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .nav-main {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
